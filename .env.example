# ══════════════════════════════════════════════════════════════════════════════
# Vigilante Digital v2.0 — Variables de entorno
# Copiar este archivo a .env y completar los valores reales.
# NUNCA comitear el .env al repositorio.
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────────────────────
# URL de conexión a PostgreSQL (sobreescribe configuración interna)
DATABASE_URL=postgresql://vigilante:CAMBIA_ESTO@localhost:5432/vigilante

# Credenciales PostgreSQL (usado por docker-compose)
POSTGRES_DB=vigilante
POSTGRES_USER=vigilante
POSTGRES_PASSWORD=CAMBIA_ESTO_PASSWORD_SEGURO

# ── API y seguridad ────────────────────────────────────────────────────────
# Token Bearer para autenticar todos los endpoints /api/v1/
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=GENERA_UN_TOKEN_SEGURO_AQUI

# Secreto para validar webhooks HMAC-SHA256 (X-Vigilante-Signature)
WEBHOOK_SECRET=GENERA_OTRO_SECRETO_AQUI

# Orígenes CORS permitidos (separados por coma, o * para todos en dev)
CORS_ORIGINS=*

# ── Identificación del nodo ─────────────────────────────────────────────────
# ID único de este nodo edge (aparece en logs y reportes)
VIGILANTE_NODE_ID=node_fuenapa_01

# Archivo de configuración del cliente (relativo a la raíz del proyecto)
VIGILANTE_CONFIG=client_config.json

# ── Cámaras IP (streams RTSP) ───────────────────────────────────────────────
# Formato: rtsp://usuario:contraseña@ip:puerto/ruta
CAM_01_URL=rtsp://admin:PASSWORD@192.168.1.101:554/stream1
CAM_02_URL=rtsp://admin:PASSWORD@192.168.1.102:554/stream1
CAM_03_URL=rtsp://admin:PASSWORD@192.168.1.103:554/stream1
CAM_04_URL=rtsp://admin:PASSWORD@192.168.1.104:554/stream1
CAM_05_URL=rtsp://admin:PASSWORD@192.168.1.105:554/stream1
CAM_06_URL=rtsp://admin:PASSWORD@192.168.1.106:554/stream1

# ── ONVIF ────────────────────────────────────────────────────────────────────
ONVIF_PASSWORD=PASSWORD_CAMARA_ONVIF

# ── MQTT (bocina / relay) ─────────────────────────────────────────────────────
# Broker MQTT para activación de hardware (protocolo estándar industria)
MQTT_BROKER=192.168.1.200
MQTT_PORT=1883
MQTT_USER=vigilante
MQTT_PASSWORD=MQTT_PASSWORD_SEGURO
MQTT_TOPIC_RELAY=vigilante/relay/sirena

# ── Email (reportes PDF) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@flucore.cl
SMTP_PASSWORD=APP_PASSWORD_GMAIL
EMAIL_RECIPIENTS=seguridad@cliente.cl,operaciones@cliente.cl

# ── Hub (cerebro Curicó) ──────────────────────────────────────────────────────
# URL del servidor central de FuenApa (dejar vacío para modo edge puro)
HUB_URL=
HUB_API_KEY=

# ── Runner ───────────────────────────────────────────────────────────────────
# Modo de operación: realtime | file | batch
RUNNER_MODE=realtime

# ── Panel de operador ────────────────────────────────────────────────────────
# Calidad JPEG para WebSocket (1-100, menor = menos ancho de banda)
PANEL_JPEG_QUALITY=60

# Activar Swagger UI (solo en desarrollo, desactivar en producción)
ENABLE_DOCS=false

# ── Zona horaria ─────────────────────────────────────────────────────────────
TZ=America/Santiago
