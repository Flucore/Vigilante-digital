# ── Vigilante Digital v2.0 — API Container ────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

# Dependencias del sistema (mínimas)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencias Python de la API
COPY requirements_api.txt* ./
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    psycopg2-binary \
    slowapi \
    onvif-zeep \
    websockets \
    python-multipart \
    opencv-python-headless \
    numpy \
    requests

# Copiar código fuente
COPY . .

# Usuario no root (seguridad)
RUN useradd -m -u 1001 vigilante && chown -R vigilante:vigilante /app
USER vigilante

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')"

CMD ["python", "-m", "uvicorn", "api.forensic_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
