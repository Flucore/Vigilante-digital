      "reconnect_delay_sec": 2.0,
      "roi": [450, 120, 360, 360],
      "min_stable_sec": 0.4,
      "min_color_ratio": 0.015
    },
    {
      "id": "CAM_4_PERIMETER_EXAMPLE",
      "name": "Perímetro",
      "url": "http://192.168.1.104:8080/video",
      "zone": "Zona Restringida",
