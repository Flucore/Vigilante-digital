      "cooldown_sec": 5.0,
      "roi": [0, 0, 1280, 720],
      "perimeter_line": {
        "start": [100, 400],
        "end": [1180, 400],
        "label": "Línea de Seguridad"
      }
    },
    {
      "id": "CAM_3_TRAFFIC_EXAMPLE",
