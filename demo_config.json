{
  "_comment": "Configuración del demo de 2 cámaras IP. Editar URLs con las IPs reales de los celulares.",
  "demo": {
    "title": "Vigilante Digital IA — Demo Ejecutivo",
    "facility": "Instalaciones Cliente",
    "operator": "Operador Demo",
    "window_width": 1920,
