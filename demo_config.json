      "perimeter_breach": ["speaker", "whatsapp"]
    },
    "email": {
      "recipient": "destinatario@empresa.cl",
      "subject": "Alerta Vigilante Digital"
    },
    "whatsapp": {
      "webhook_url": "http://localhost:8088/whatsapp",
      "to": "+569XXXXXXXX",
      "message_template": "Alerta Vigilante Digital"
    },
    "speaker": {
      "host": "http://192.168.1.200:5000",
      "volume": 80,
      "mp3_url": null
    },
    "webhook": {
      "url": "http://localhost:8088/events",
      "timeout_sec": 5.0
    }
