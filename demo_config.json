      "sector": "Sector Norte",
      "module": "fall_detection",
      "enabled": true,
      "reconnect_attempts": 10,
      "reconnect_delay_sec": 2.0
    },
    {
      "id": "CAM_2",
      "name": "Polera Roja",
      "url": "http://192.168.1.102:8080/video",
